read_type = config.get("read_type", "short")
if read_type not in ("short", "hifi"):
    raise ValueError("read_type must be short or hifi")
warm_start = bool(config.get("genomes")) and str(config["iteration"]) == "1"
target_file = (
    f"iter_{config['iteration']}/bin_mapping/reads.fq.gz"
    if read_type == "hifi"
    else f"iter_{config['iteration']}/bin_mapping/reads.1.fq.gz"
)

wildcard_constraints:
    iteration=str(config["iteration"])

rule all:
    input:
        target_file

if read_type == "hifi":
    include: "rules/hifi.smk"
else:
    if not warm_start:
        include: "rules/assembly.smk"
        include: "rules/readmapping.smk"
    include: "rules/symlink.smk"
    include: "rules/map_reads_mags.smk"

if warm_start:
    include: "rules/warm_start.smk"
else:
    include: "rules/binning.smk"

include: "rules/checkm.smk"
